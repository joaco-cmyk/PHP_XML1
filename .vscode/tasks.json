{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PHP: iniciar previsualización",
      "type": "shell",
      "command": "php -S 0.0.0.0:8000 -t \"${workspaceFolder}\"",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^$",
          "endsPattern": "a^"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}